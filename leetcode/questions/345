/*
345. Reverse Vowels of a String

Given a string s, reverse only all the vowels in the string and return it.

The vowels are 'a', 'e', 'i', 'o', and 'u', and they can appear in both lower and upper cases, more than once.

 

Example 1:

Input: s = "IceCreAm"

Output: "AceCreIm"

Explanation:

The vowels in s are ['I', 'e', 'e', 'A']. On reversing the vowels, s becomes "AceCreIm".

Example 2:

Input: s = "leetcode"

Output: "leotcede"
*/

// My Answer 

const reverseVowels = function (s) {

  // Create vowel array for later comparisons
  const vowels = ['a', 'e', 'i', 'o', 'u'];

  // Empty array to store vowels taken from string 
  const takenVowels = [];

  // Splits string into array with each letter as an element
  // so i can loop through each letter
  const splitString = s.split('');

  for (let i = 0; i < splitString.length; i++) {
    
    // checks if element is in vowel array
    // converts element into lowercase to remove case sensitivity  
    if (vowels.includes(splitString[i].toLowerCase())) {
      
      // Store vowels into earlier array
      takenVowels.push(splitString[i]);
      
      // Change vowels to 0 placeholders to mark index for replacements
      splitString[i] = 0;
    }
  }

  // Reverse elements in array
  takenVowels.reverse()

  for (let i = 0; i < splitString.length; i++) {
    
    // Checks if element is 0 placeholder
    if (splitString[i] === 0) {
      
      // Replaces placeholder with first element in reverse array
      splitString[i] = takenVowels[0];
      
      // Removes first element to prevent repeats
      takenVowels.shift();
    }
  }
  
  // returns string concatenated from elements in splitString array 
  return splitString.join('');
};