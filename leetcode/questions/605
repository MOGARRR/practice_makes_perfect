/*
605. Can Place Flowers
You have a long flowerbed in which some of the plots are planted, and some are not. However, flowers cannot be planted in adjacent plots.

Given an integer array flowerbed containing 0's and 1's, 
where 0 means empty and 1 means not empty, and an integer n,
return true if n new flowers can be planted in the flowerbed without violating the no-adjacent-flowers rule and false otherwise.

Example 1:

Input: flowerbed = [1,0,0,0,1], n = 1
Output: true
Example 2:

Input: flowerbed = [1,0,0,0,1], n = 2
Output: false
 

Constraints:

1 <= flowerbed.length <= 2 * 104
flowerbed[i] is 0 or 1.
There are no two adjacent flowers in flowerbed.
0 <= n <= flower

*/ 


// My Answer 


const canPlaceFlowers = function(flowerbed, n) {

   // Using a for loop instead of array for of loop
   // This makes tracking the elements before and after i easier 
    for (let i = 0; i <= flowerbed.length; i++){

      // Main if statement
      // comparison checks if the element before/after are valid, and if i is valid too
      if (flowerbed[i - 1] === 0 && flowerbed[i + 1] === 0 && flowerbed[i] !== 1){
          
          //If valid, it will update element to 1 for future comparisons
          flowerbed[i]++;
        
          // Updates n to track remaining "Plants" for final result
            n--;
        }

        // First edge case if statement
        // Checks if element is first in the list and is valid
        
        // This statement is needed since  the element before is undefined
        // and is considered false in main comparison statement
        if(i === 0 && flowerbed[1] === 0 && flowerbed[i] !== 1){
            flowerbed[i]++;
            n--;
        }

        // Second edge case if statement
        // same as previous edge case but for the last element in the array 
        if(i === flowerbed.length - 1 && flowerbed[i -1] === 0 && flowerbed[i] !== 1){
            flowerbed[i]++;
            n--;
        }

        // Third edge case if statement
        // Checks if array only has one element and if its valid
        
        // This statement is needed since an array of 1 has no before or after
        // element so it would falsy in main comparison 
        if (flowerbed.length === 1 && flowerbed[0] !== 1 ){
            flowerbed[i]++;
            n--;
        }
    }

    // Final result if statement
    // Checks if all the "plants" in n have been planted

    // if theres no plants remaining it will return true
    // and if theres any remaining it will return false
    if(n <= 0 ) {
        return true;
    } else {
        return false;
    }
};
